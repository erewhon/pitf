#!/bin/sh
# pitf-meta: `pitf meta ...` runs `meta` inside the meta uv project.
# The Python tools stay Python; this shim just finds the checkout.
# Override the smithy checkout with PITF_SMITHY_DIR (default ~/code/smithy).
set -eu
root="${PITF_SMITHY_DIR:-$HOME/code/smithy}"
proj="$root/meta"
if [ ! -f "$proj/pyproject.toml" ]; then
  echo "pitf-meta: project not found at $proj (set PITF_SMITHY_DIR)" >&2
  exit 127
fi
exec uv run -q --project "$proj" meta "$@"
